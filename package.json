{
  "name": "motion-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local motion-design editor (Vite + React + TypeScript + Express). Preview and export share one pure renderFrame().",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "render": "tsx server/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "playwright": "1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "vite": "^5.4.11",
    "zod": "^3.24.1",
    "zustand": "^5.0.2",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
